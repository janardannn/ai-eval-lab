DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aievallab
REDIS_URL=redis://localhost:6379
DOCKER_HOST=unix:///var/run/docker.sock

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STT_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_VOICE_ID=your-voice-id

AUTH_SECRET=generate-with-npx-auth-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

NEXT_PUBLIC_APP_URL=http://localhost:3000
KICAD_IMAGE=ai-eval-lab-kicad
MAX_CONTAINERS=3

# Base domain for per-session noVNC hosts. Each session gets
# https://s_<sessionId>.<VNC_DOMAIN> routed via Caddy admin API.
# Leave unset for local dev (falls back to http://localhost:<random-port>).
# VNC_DOMAIN=vnc.ael.janardan.xyz
# CADDY_ADMIN_URL=http://caddy:2019

# Shared secret for container→backend auth (poller, grader, queue provisioning)
INTERNAL_API_SECRET=generate-a-random-256bit-hex-string

# Override backend URL seen by KiCad containers (default: http://host.docker.internal:3000)
# CONTAINER_CALLBACK_URL=http://host.docker.internal:3000

RESEND_API_KEY=re_your-key-here
EMAIL_FROM=noreply@ai-eval-lab.com

ADMIN_EMAILS=your@email.com
CRON_SECRET=your-cron-secret
