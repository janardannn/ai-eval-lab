{
	on_demand_tls {
		ask http://web:3000/api/internal/tls-ok
	}
	admin 0.0.0.0:2019 {
		origins localhost caddy web host.docker.internal 127.0.0.1
	}
}

{$DOMAIN:localhost} {
	reverse_proxy web:3000
}

*.{$VNC_DOMAIN:vnc.localhost} {
	tls {
		on_demand
	}
	# Per-session reverse_proxy routes are added dynamically via the Caddy
	# admin API (see apps/web/src/lib/caddy.ts). Until a route exists for a
	# given subdomain, requests fall through here and get aborted.
	abort
}
